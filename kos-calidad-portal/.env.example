# Copia este archivo a .env y ajusta los valores. El .env real está en .gitignore.
# Estas variables las lee backend/app/config.py (Azure SQL / SQL Server).

# --- Base de datos del portal de calidad ---
BD_HOST = TUSERVIDOR.database.windows.net
BD_NAME = kx_ecommerce          # base donde vive el esquema 'calidad' del portal
BD_USER = usuario
BD_PASSWORD = clave

# --- Base de datos de aplicaciones KOS (mismo servidor y credenciales) ---
# Contiene la tabla dbo.personal_planta, que alimenta el catálogo de personas
# del portal (firmas F-006, responsable F-015). Si se omite, no se sincroniza
# y se usa el último catálogo cargado. Ver backend/app/personal.py.
BD_NAME_DATA = kos_apps

# --- Adjuntos: Azure Data Lake / Blob Storage ---
# Cuenta donde se guardan las fotos y videos de los formatos (F-158). Si se
# omite, los archivos se guardan en backend/uploads/ (solo desarrollo local).
# En producción es OBLIGATORIA: el disco del App Service se borra en cada
# despliegue y los adjuntos se perderían.
#
# No lleva claves: el backend se autentica con la identidad administrada del
# App Service (en local, con la sesión de `az login`). Esa identidad necesita
# dos roles sobre la cuenta de storage:
#   - Storage Blob Data Contributor  (subir y leer archivos)
#   - Storage Blob Data Delegator    (firmar los enlaces temporales de lectura)
AZURE_STORAGE_ACCOUNT = nombredetucuenta
AZURE_STORAGE_CONTAINER = adjuntos
# Validez en segundos de los enlaces de descarga (por defecto 3600 = 1 hora).
# SAS_TTL = 3600
