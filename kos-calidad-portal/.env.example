# Copia este archivo a .env y ajusta los valores. El .env real está en .gitignore.
# Estas variables las lee backend/app/config.py (Azure SQL / SQL Server).

# --- Base de datos del portal de calidad ---
BD_HOST = TUSERVIDOR.database.windows.net
BD_NAME = kx_ecommerce          # base donde vive el esquema 'calidad' del portal
BD_USER = usuario
BD_PASSWORD = clave

# --- Base de datos de aplicaciones KOS (mismo servidor y credenciales) ---
# Contiene la tabla dbo.personal_planta, que alimenta el catálogo de personas
# del portal (firmas F-006, responsable F-015). Si se omite, no se sincroniza
# y se usa el último catálogo cargado. Ver backend/app/personal.py.
BD_NAME_DATA = kos_apps
