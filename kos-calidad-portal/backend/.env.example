# Copia este archivo a .env y ajusta los valores.

# --- Base de datos ---
# Desarrollo local (por defecto si no se define): SQLite, sin instalar nada.
# DATABASE_URL=sqlite:///./kos_calidad.db
#
# Producción con Azure SQL / SQL Server (requiere ODBC Driver 18 y pyodbc):
# DATABASE_URL=mssql+pyodbc://USUARIO:CLAVE@SERVIDOR.database.windows.net:1433/BASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# --- CORS ---
# Orígenes permitidos para el frontend (separados por coma). * para desarrollo.
CORS_ORIGINS=*
